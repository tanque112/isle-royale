// Reglas de Firestore para las cuentas online de Isla Royale (ver js/online.js).
// - Cualquiera puede LEER las fichas (para los rankings).
// - Cada jugador sólo puede ESCRIBIR la suya, y con límites para que no se pueda
//   poner de golpe un millón de bajas o de monedas desde la consola del navegador.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid} {
      allow read: if true;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Za-z0-9_]{3,14}$')
        && request.resource.data.matches == 0
        && request.resource.data.wins == 0
        && request.resource.data.kills == 0
        && request.resource.data.rp == 0
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= 100000;

      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.matches >= resource.data.matches
        && request.resource.data.matches <= resource.data.matches + 1
        && request.resource.data.wins >= resource.data.wins
        && request.resource.data.wins <= resource.data.wins + 1
        && request.resource.data.kills >= resource.data.kills
        && request.resource.data.kills <= resource.data.kills + 100
        && request.resource.data.rp is int
        && request.resource.data.rp >= 0
        && request.resource.data.rp <= resource.data.rp + 400
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.coins <= resource.data.coins + 10000;

      allow delete: if false;
    }
  }
}
